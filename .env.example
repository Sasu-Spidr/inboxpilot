GROQ_API_KEY=replace_me
MICROSOFT_CLIENT_ID=replace_me
MICROSOFT_CLIENT_SECRET=replace_me

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_me

# Generate with:
# openssl rand -hex 32
AUTH_SECRET=replace_me

POSTGRES_DB=spidr_mail
POSTGRES_USER=spidr
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://spidr:replace_me@postgres:5432/spidr_mail

OAUTH_BASE_URL=http://localhost:8080
OAUTH_PUBLIC_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
OAUTH_PORT=8080
OAUTH_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

GMAIL_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json

INBOXPILOT_PRIVATE_CLIENT_MODE=true
INBOXPILOT_ENABLE_LANDING=false
PUBLIC_SIGNUP_ENABLED=true
SIGNUP_ACCESS_CODE=

SECURITY_BLOCKED_EMAIL_DOMAINS=
SIGNUP_MIN_SECONDS=3
REGISTER_RATE_LIMIT_1H=5
LOGIN_RATE_LIMIT_15M=10
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SESSION_MAX_AGE_SECONDS=86400

CALENDAR_SYNC_ENABLED=true
CALENDAR_SYNC_RUN_HOUR=0
CALENDAR_SYNC_DAYS=1
CALENDAR_SYNC_TIMEZONE=Europe/Paris
